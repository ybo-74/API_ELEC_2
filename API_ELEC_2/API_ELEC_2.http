# ─────────────────────────────────────────────────────────────
# FLIGHTS
# ─────────────────────────────────────────────────────────────

### GET ALL FLIGHTS
GET {{API_ELEC_2_HostAddress}}/api/flights
Accept: application/json

###

### GET COMPLETED FLIGHTS
GET {{API_ELEC_2_HostAddress}}/api/flights/completed
Accept: application/json

###

### CREATE FLIGHT
POST {{API_ELEC_2_HostAddress}}/api/flights
Content-Type: application/json

{
  "originID": 1,
  "destinationID": 2,
  "airlineID": 1,
  "travelDate": "2026-12-25",
  "travelTime": "08:00:00",
  "maxPax": 60
}

###

### UPDATE FLIGHT
PUT {{API_ELEC_2_HostAddress}}/api/flights/1
Content-Type: application/json

{
  "originID": 1,
  "destinationID": 3,
  "airlineID": 2,
  "travelDate": "2026-12-26",
  "travelTime": "10:00:00",
  "maxPax": 60
}

###

### DELETE FLIGHT
DELETE {{API_ELEC_2_HostAddress}}/api/flights/1
Accept: application/json

###


# ─────────────────────────────────────────────────────────────
# BOOKINGS
# ─────────────────────────────────────────────────────────────

### GET AVAILABLE FLIGHTS
GET {{API_ELEC_2_HostAddress}}/api/bookings/available
Accept: application/json

###

### Get All Bookings
GET {{API_ELEC_2_HostAddress}}/api/bookings

### GET BOOKING DETAILS BY BOOKING ID
GET {{API_ELEC_2_HostAddress}}/api/bookings/details/1
Accept: application/json

###

### CREATE BOOKING
POST {{API_ELEC_2_HostAddress}}/api/bookings
Content-Type: application/json

{
  "flightID": 1,
  "lastName": "Santos",
  "firstName": "Maria",
  "middleName": "Cruz",
  "contact": "09171234567",
  "birthdate": "1995-06-20",
  "age": 30
}

###

### UPDATE PASSENGER INFO
PUT {{API_ELEC_2_HostAddress}}/api/bookings/1
Content-Type: application/json

{
  "lastName": "Santos",
  "firstName": "Maria",
  "contact": "09179999999",
  "birthdate": "1995-06-20",
  "age": 30
}

###

### TRANSFER FLIGHT
PUT {{API_ELEC_2_HostAddress}}/api/bookings/1/transfer
Content-Type: application/json

{
  "newFlightID": 2
}

###

### CANCEL BOOKING
DELETE {{API_ELEC_2_HostAddress}}/api/bookings/1
Accept: application/json

###


# ─────────────────────────────────────────────────────────────
# ADD OTHERS
# ─────────────────────────────────────────────────────────────

### GET ADD-ONS BY BOOKING ID
GET {{API_ELEC_2_HostAddress}}/api/addothers/booking/1
Accept: application/json

###

### GET ADD-ONS BY PAX ID
GET {{API_ELEC_2_HostAddress}}/api/addothers/pax/1
Accept: application/json

###

### CREATE ADD-ON
POST {{API_ELEC_2_HostAddress}}/api/addothers
Content-Type: application/json

{
  "bookingID": 1,
  "paxID": 1,
  "mealID": 1,
  "seatID": 1,
  "baggageID": 1,
  "insuranceID": 1,
  "isMeal": true,
  "isSeat": true,
  "isBaggage": true,
  "isInsurance": true
}

###

### UPDATE ADD-ON
PUT {{API_ELEC_2_HostAddress}}/api/addothers/1
Content-Type: application/json

{
  "mealID": 2,
  "seatID": 3,
  "baggageID": 2,
  "insuranceID": 1,
  "isMeal": true,
  "isSeat": true,
  "isBaggage": false,
  "isInsurance": true
}

###

### SOFT DELETE ADD-ON (sets IsActive = 0)
DELETE {{API_ELEC_2_HostAddress}}/api/addothers/1
Accept: application/json

###


